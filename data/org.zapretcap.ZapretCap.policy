<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Zapret Cap</vendor>
  <icon_name>org.zapretcap.ZapretCap</icon_name>
  <action id="org.zapretcap.ZapretCap.run">
    <description>Управление обходом блокировок Zapret Cap</description>
    <message>Чтобы изменить настройки обхода, нужен пароль администратора</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <!-- пароль спрашивается один раз за несколько минут, а не на каждое нажатие -->
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/opt/zapret-cap/zapret</annotate>
  </action>
</policyconfig>
